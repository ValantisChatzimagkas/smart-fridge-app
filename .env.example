# Copy to .env and change the password before running.
MONGO_USERNAME=root
MONGO_PASSWORD=change-me
MONGO_DB_NAME=ingredients_db

# Origins allowed by CORS (comma-separated); must include the URL the UI is served from.
CORS_ORIGINS=http://localhost:5173

# Published host ports
API_PORT=8000
UI_PORT=5173
MONGO_PORT=27017

# API URL the browser uses; baked into the UI at build time.
VITE_API_URL=http://localhost:8000
